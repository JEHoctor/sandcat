#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=../../lib/require.bash
source "$SCT_LIBDIR/require.bash"
# shellcheck source=../../lib/engine.bash
source "$SCT_LIBDIR/engine.bash"
# shellcheck source=../../lib/path.bash
source "$SCT_LIBDIR/path.bash"

# Helper that automatically locates the compose file.
# All arguments are passed through to the engine's compose implementation.
compose() {
	require_engine

	local compose_file
	compose_file="$(find_compose_file)"

	sct_engine_compose_exec -f "$compose_file" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
	compose "$@"
fi
