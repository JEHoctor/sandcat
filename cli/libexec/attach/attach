#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=../../lib/require.bash
source "$SCT_LIBDIR/require.bash"
# shellcheck source=../../lib/engine.bash
source "$SCT_LIBDIR/engine.bash"
# shellcheck source=../../lib/path.bash
source "$SCT_LIBDIR/path.bash"

attach() {
	require_engine

	local compose_file
	compose_file="$(find_compose_file)"

	if (($# == 0))
	then
		sct_engine_compose_exec -f "$compose_file" exec -u vscode agent bash --login
	fi

	sct_engine_compose_exec -f "$compose_file" exec -u vscode agent "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
	attach "$@"
fi
